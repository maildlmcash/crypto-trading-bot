{
  "name": "crypto-trading-bot",
  "private": true,
  "version": "0.3.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/control-web run dev",
    "build": "npm --workspace apps/control-web run build",
    "check": "npm --workspace apps/control-web run build && npm --workspace services/control-api run build",
    "test": "npm --workspace apps/control-web run test"
  }
}
